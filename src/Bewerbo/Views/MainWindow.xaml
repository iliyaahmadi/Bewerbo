<Window x:Class="Bewerbo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Bewerbo.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Bewerbo — Application tracker"
        Icon="pack://application:,,,/Bewerbo;component/Assets/Bewerbo.ico"
        Width="1240" Height="850" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource NavButton}" Command="{Binding Command}" ToolTip="{Binding Label}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Count}" Margin="10,0,0,0" FontSize="12" FontWeight="Normal"
                               Opacity="0.65" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="StatusFilterTemplate" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource FilterChip}" Command="{Binding Command}" MaxWidth="320" ToolTip="{Binding Label}">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Count, Mode=OneWay}" />
                </TextBlock>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:ApplicationCardViewModel}">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,18,20,16" Margin="0,0,0,12"
                    AllowDrop="True" DragEnter="OnCardDragOver" DragOver="OnCardDragOver" DragLeave="OnCardDragLeave" Drop="OnCardDrop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="11" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InitialsBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Padding" Value="7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InitialsTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource VisibleWhenTrue}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Company}" ToolTip="{Binding Company}" FontSize="17" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Position}" ToolTip="{Binding Position}" FontSize="14" Margin="0,4,0,10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <WrapPanel>
                            <Border CornerRadius="4" Padding="7,3" Margin="0,0,10,0" Visibility="{Binding HasType, Converter={StaticResource VisibleWhenTrue}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Tag0Brush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Tag0TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TagColor}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource Tag1Brush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Tag1TextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TagColor}" Value="2">
                                                <Setter Property="Background" Value="{DynamicResource Tag2Brush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Tag2TextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TagColor}" Value="3">
                                                <Setter Property="Background" Value="{DynamicResource Tag3Brush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Tag3TextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" />
                            </Border>
                            <TextBlock Text="{Binding Salary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding HasSalary, Converter={StaticResource VisibleWhenTrue}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Details}" ToolTip="{Binding Details}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasDetails, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFollowUpDue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding NotesPreview}" ToolTip="{Binding Notes}" FontSize="12" Margin="0,11,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhenTrue}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <ComboBox Style="{StaticResource StatusComboBox}" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Open link ↗" Command="{Binding OpenLinkCommand}"
                                    FontSize="11" Padding="6,5" Visibility="{Binding HasLink, Converter={StaticResource VisibleWhenTrue}}" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding FilesCommand}" ToolTip="{Binding FilesToolTip}"
                                    FontSize="11" Padding="6,5" Margin="6,0,0,0" Visibility="{Binding ShowFiles, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock><Run Text="📄" FontFamily="Segoe UI Emoji" /><Run Text=" " /><Run Text="{Binding FilesText, Mode=OneWay}" /></TextBlock>
                            </Button>
                            <Button Content="Edit" Command="{Binding EditCommand}" FontSize="11" Padding="10,5" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="22,28,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Bewerbo" FontSize="24" FontWeight="SemiBold" Margin="9,0,0,0" />

                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock Text="APPLICATIONS" Style="{StaticResource SectionLabel}" Margin="10,0,0,8" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                    </ScrollViewer>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,13,14,7" Margin="0,22,0,0">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="RowLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Style>
                            <Style x:Key="RowValue" TargetType="TextBlock">
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,0,0,7" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="OVERVIEW" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="{Binding Summary.Remaining}" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,8">
                                <Run Text="remaining of" /> <Run Text="{Binding Summary.Total, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Summary.RemainingByType}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource RowValue}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Interviewing" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding Summary.Interviewing}" Style="{StaticResource RowValue}" Foreground="{DynamicResource WarningBrush}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Offers / accepted" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding Summary.OffersOrAccepted}" Style="{StaticResource RowValue}" Foreground="{DynamicResource SuccessBrush}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Follow-ups due" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding Summary.FollowUpsDue}" Style="{StaticResource RowValue}" Foreground="{DynamicResource AccentLightBrush}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Rejected" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding Summary.Rejected}" Style="{StaticResource RowValue}" Foreground="{DynamicResource DangerBrush}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Summary.Withdrawn}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock Text="Withdrawn" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding Summary.Withdrawn}" Style="{StaticResource RowValue}" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4">
                    <Button Content="Import from folders" Command="{Binding ImportFoldersCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,4"
                            ToolTip="Add applications for company folders that don't have one yet" />
                    <Button Content="Export backup" Command="{Binding ExportCommand}" Background="{DynamicResource FieldHoverBrush}"
                            Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,7" />
                    <Button Content="Import backup" Command="{Binding ImportCommand}" Style="{StaticResource GhostButton}" />
                    <Button Content="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource GhostButton}" Margin="0,4,0,0"
                            ToolTip="Theme and documents folder (Ctrl+,)" />
                    <TextBlock Text="Saved locally" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="34,28,34,19">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                <Button Grid.Column="1" Content="+  Add application" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Padding="20,13"
                        ToolTip="Add an application (Ctrl+N). Copied the details from a chat? Press Ctrl+V anywhere here to fill the form in." />
            </Grid>

            <Grid Grid.Row="1" Margin="0,25,0,0">
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="15,9,46,9">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Search company, position or notes…" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="✕" ToolTip="Clear search (Esc)" Command="{Binding ClearSearchCommand}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Width="32" Height="32" Padding="0"
                        FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextMutedBrush}"
                        Visibility="{Binding HasSearch, Converter={StaticResource VisibleWhenTrue}}" />
            </Grid>

            <StackPanel Grid.Row="2">
                <ItemsControl ItemsSource="{Binding StatusFilters}" ItemTemplate="{StaticResource StatusFilterTemplate}" Margin="0,15,0,5" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="APPLICATIONS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />

                    <!-- Shown while Advanced filters are set: click to change them, ✕ to drop them. -->
                    <Border Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,12,0" CornerRadius="6"
                            Background="{DynamicResource ControlHoverBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Visibility="{Binding HasAdvancedFilters, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding AdvancedFiltersLabel}" Command="{Binding OpenFiltersCommand}" ToolTip="Change the advanced filters"
                                    Style="{StaticResource GhostButton}" FontSize="11" Padding="10,5,4,5" />
                            <Button Content="✕" Command="{Binding ClearAdvancedCommand}" ToolTip="Remove the advanced filters" Style="{StaticResource GhostButton}"
                                    FontSize="10" FontWeight="Normal" Padding="7,5" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GhostButton}"
                            FontSize="11" Padding="10,7" Margin="6,0,0,0" />
                    <ComboBox Grid.Column="5" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label"
                              MinHeight="34" FontSize="12" ToolTip="Sort, or open Advanced filters" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="3">
                <!-- Virtualized, so only the cards on screen are created. -->
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                              Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,8,0" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource VisibleWhenTrue}}">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Width="72" Height="72" CornerRadius="22" HorizontalAlignment="Center">
                        <TextBlock Text="+" FontSize="42" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,0" />
                    <TextBlock Text="{Binding EmptySubtitle}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,9,0,21" />
                    <Button Content="+  Add application" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoApplications, Converter={StaticResource VisibleWhenTrue}}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="4" Text="{Binding Footer}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,13,0,0" />
        </Grid>
    </Grid>
</Window>
