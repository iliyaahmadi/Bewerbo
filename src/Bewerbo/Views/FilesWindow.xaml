<Window x:Class="Bewerbo.Views.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Bewerbo.ViewModels"
        xmlns:views="clr-namespace:Bewerbo.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FilesViewModel}"
        Title="{Binding Company, StringFormat='Files · {0}'}"
        Width="620" Height="560" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Style="{StaticResource AppWindow}">

    <Grid Margin="28,8,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding Company}" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Position}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <views:DocumentsView Grid.Row="1" DataContext="{Binding Documents}" />

        <Button Grid.Row="2" Content="Done" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </Grid>
</Window>
