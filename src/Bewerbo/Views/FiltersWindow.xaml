<Window x:Class="Bewerbo.Views.FiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Bewerbo.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FiltersViewModel}"
        Title="Advanced filters"
        Width="560" Height="640" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Advanced filters" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="POSITION" Style="{StaticResource SectionLabel}" Margin="0,24,0,8" />
        </StackPanel>

        <!-- Positions in the current category. None ticked means every position. -->
        <Border Grid.Row="1" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ControlBrush}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                    <ItemsControl ItemsSource="{Binding Positions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PositionChoice}">
                                <Border x:Name="Row" CornerRadius="7" Padding="10,8" Background="Transparent">
                                    <CheckBox IsChecked="{Binding IsSelected}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0" />
                                        </Grid>
                                    </CheckBox>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="No positions yet" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPositions}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Applied from" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AppliedFrom, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" ToolTip="YYYY-MM-DD" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Applied until" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AppliedTo, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" ToolTip="YYYY-MM-DD" />
                </StackPanel>
            </Grid>
            <TextBlock Text="YYYY-MM-DD. Leave a date empty for no limit." Style="{StaticResource HintText}" />

            <TextBlock Text="Location contains" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="Only applications with a follow-up due" IsChecked="{Binding FollowUpDueOnly}" Margin="0,18,0,0" />

            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource GhostButton}" ToolTip="Clear every filter in this window" />
            <Button Grid.Column="2" Content="Cancel" IsCancel="True" />
            <Button Grid.Column="4" Content="Apply filters" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
