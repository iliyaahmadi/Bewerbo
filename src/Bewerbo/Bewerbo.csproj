<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Bewerbo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Bewerbo.ico" />
    <Resource Include="Assets\header-dark.png" />
    <Resource Include="Assets\header-light.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bewerbo.Core\Bewerbo.Core.csproj" />
  </ItemGroup>

</Project>
